# ==============================================================================
# Python & Bytecode
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# Virtual Environments & Package Managers
# ==============================================================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
pip-log.txt
pip-delete-this-directory.txt

# ==============================================================================
# Jupyter Notebooks
# ==============================================================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.converted.ipynb

# ==============================================================================
# Data & Datasets (Prevent pushing large datasets to Git)
# ==============================================================================
data/raw/*
data/processed/*
data/interim/*
data/external/*
!data/**/.gitkeep

# Large data formats
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.jsonl
*.zip
*.tar.gz
*.tar
*.gz
*.7z
*.rar

# (Optional exception: allow tracked sample or schema files if needed)
# !data/sample/*.csv

# ==============================================================================
# Machine Learning Models, Checkpoints & Artifacts
# ==============================================================================
models/*
checkpoints/*
saved_models/*
!models/.gitkeep
!checkpoints/.gitkeep

# Serialized weights and artifacts
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.safetensors
*.bin
*.weights
*.ckpt
*.tflite
*.h5
*.pb

# ==============================================================================
# Experiment Tracking, Profilers & Logs
# ==============================================================================
logs/
*.log
runs/
lightning_logs/
mlruns/
wandb/
tensorboard/
.aim/
comet-ml-runs/

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.local
.env.*.local
*.env
credentials.json
secrets.json
*.pem
*.key
*.token
# Except example config
!.env.example

# ==============================================================================
# IDEs & System Files
# ==============================================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
